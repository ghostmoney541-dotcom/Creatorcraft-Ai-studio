```css
@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap");

:root {
  --background: #11100f;
  --surface: #191817;
  --surface-light: #24211f;
  --text: #f2eee7;
  --muted: #aaa39a;
  --line: #3a3530;
  --accent: #d8ff3e;
  --accent-dark: #a9c91f;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 80% 10%, rgba(216, 255, 62, 0.08), transparent 28rem),
    var(--background);
  color: var(--text);
  font-family: "Space Grotesk", sans-serif;
}

button,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-shell {
  min-height: 100vh;
  overflow: hidden;
}

.topbar {
  align-items: center;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  padding: 1.25rem 5vw;
}

.brand {
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.brand span {
  color: var(--accent);
}

.status,
.tool-count,
.eyebrow {
  color: var(--muted);
  font-family: "DM Mono", monospace;
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero {
  min-height: 78vh;
  padding: 12vh 10vw 10vh;
  position: relative;
}

.hero h1 {
  font-size: clamp(4rem, 11vw, 10rem);
  letter-spacing: -0.09em;
  line-height: 0.86;
  margin: 1.5rem 0;
  max-width: 1000px;
}

.hero h1 span {
  color: var(--accent);
}

.intro {
  color: var(--muted);
  font-size: clamp(1rem, 1.8vw, 1.35rem);
  line-height: 1.6;
  max-width: 32rem;
}

.primary-button {
  background: var(--accent);
  border: 1px solid var(--accent);
  color: #11100f;
  cursor: pointer;
  display: inline-block;
  font-family: "DM Mono", monospace;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  margin-top: 1.5rem;
  padding: 1rem 1.25rem;
  text-transform: uppercase;
  transition: background 180ms ease, color 180ms ease, transform 180ms ease;
}

.primary-button:hover {
  background: transparent;
  color: var(--accent);
  transform: translateY(-2px);
}

.sigil {
  color: var(--accent);
  font-size: clamp(8rem, 22vw, 20rem);
  line-height: 1;
  opacity: 0.12;
  position: absolute;
  right: 5vw;
  top: 18%;
  transform: rotate(18deg);
}

.studio {
  border-top: 1px solid var(--line);
  padding: 7rem 5vw;
}

.section-heading {
  align-items: end;
  display: flex;
  justify-content: space-between;
  margin-bottom: 3rem;
}

h2 {
  font-size: clamp(2rem, 5vw, 4.5rem);
  letter-spacing: -0.06em;
  line-height: 0.95;
  margin: 0.75rem 0 0;
}

.tool-grid {
  display: grid;
  gap: 1px;
  grid-template-columns: repeat(4, 1fr);
}

.tool-card {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--text);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  min-height: 15rem;
  padding: 1.5rem;
  position: relative;
  text-align: left;
  transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
}

.tool-card:hover,
.tool-card.selected {
  background: var(--surface-light);
  border-color: var(--accent);
  transform: translateY(-4px);
}

.tool-icon {
  color: var(--accent);
  font-size: 2rem;
  margin-bottom: auto;
}

.tool-name {
  font-size: 1.15rem;
  font-weight: 600;
}

.tool-description {
  color: var(--muted);
  font-size: 0.85rem;
  line-height: 1.45;
  margin-top: 0.6rem;
  max-width: 15rem;
}

.tool-arrow {
  color: var(--accent);
  font-size: 1.25rem;
  position: absolute;
  right: 1.25rem;
  top: 1.25rem;
}

.project-panel {
  background: var(--surface);
  border: 1px solid var(--line);
  margin-top: 4rem;
  max-width: 52rem;
  padding: clamp(1.5rem, 5vw, 4rem);
}

.project-panel label {
  color: var(--muted);
  display: block;
  font-family: "DM Mono", monospace;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  margin-top: 2rem;
  text-transform: uppercase;
}

textarea {
  background: var(--background);
  border: 1px solid var(--line);
  color: var(--text);
  display: block;
  line-height: 1.5;
  margin-top: 0.75rem;
  padding: 1rem;
  resize: vertical;
  width: 100%;
}

textarea:focus {
  border-color: var(--accent);
  outline: 2px solid rgba(216, 255, 62, 0.2);
}

.feedback {
  color: var(--accent);
  line-height: 1.5;
  margin: 1.5rem 0 0;
}

.disclaimer {
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.5;
  margin: 1.5rem 0 0;
}

.footer {
  border-top: 1px solid var(--line);
  color: var(--muted);
  display: flex;
  font-family: "DM Mono", monospace;
  font-size: 0.7rem;
  justify-content: space-between;
  letter-spacing: 0.1em;
  padding: 1.5rem 5vw;
}

@media (max-width: 900px) {
  .tool-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    min-height: 70vh;
  }

  .sigil {
    right: -4rem;
  }
}

@media (max-width: 600px) {
  .topbar,
  .footer,
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 1rem;
  }

  .status {
    display: none;
  }

  .hero {
    padding: 8rem 1.5rem 6rem;
  }

  .studio {
    padding: 5rem 1.5rem;
  }

  .tool-grid {
    grid-template-columns: 1fr;
  }

  .tool-card {
    min-height: 12rem;
  }

  .footer {
    padding: 1.5rem;
  }
}
```
